# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load.
ZSH_THEME="agnoster"

# Auto-update settings
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 90

# Enable command auto-correction.
ENABLE_CORRECTION="false"

# Enable completion waiting dots.
COMPLETION_WAITING_DOTS="true"

# Set history timestamp format.
HIST_STAMPS="dd/mm/yyyy"

# List of plugins to load.
# You may need to install zsh-autosuggestions and zsh-syntax-highlighting separately.
# For example, by cloning them into your $ZSH_CUSTOM/plugins directory.
plugins=(
  gitfast
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Source Oh My Zsh.
source $ZSH/oh-my-zsh.sh

# Custom functions
if command -v gh >/dev/null 2>&1; then
  eval "$(gh copilot alias -- zsh)"; fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"; fi
[[ -r "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"; fi
killport() {
  local port="$1"
  lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | xargs -r kill -9
}

# Load aliases
if [ -f ~/.aliases ]; then
  source ~/.aliases
fi

# nvmd5
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# fetch
echo ''
if (( $+commands[neofetch] )); then
    neofetch
elif (( $+commands[fastfetch] )); then
    fastfetch
fi
