server {
    listen 443 ssl;
    server_name {{ item.name }}.{{ domain_name }} {% if item.alias %}{{ item.alias }}.{{ domain_name }}{% endif %};

    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    location / {
{% if item.alias %}
        if ($host != '{{ item.name }}.{{ domain_name }}') {
            return 301 https://{{ item.name }}.{{ domain_name }}$request_uri;
        }
{% endif %}

        proxy_pass {{ 'https://' if item.ssl == 'true' else 'http://' }}{{ item.host }}:{{ item.port }};
{% if item.ssl == 'true' %}
        proxy_ssl_verify off;
{% endif %}
{% if lookup('file', 'files/custom_sites/{{ item.name }}.{{ domain_name }}', errors='ignore') %}
        {{ lookup('file', 'files/custom_sites/{{ item.name }}.{{ domain_name }}') }}
{% else %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }

    location @custom_502 {
        add_header Content-Type text/plain;
        return 502 "Upstream failed: $upstream_addr\n";
    }
}
