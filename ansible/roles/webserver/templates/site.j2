server {
    listen 443 ssl;
    server_name {{ item.key }}.{{ domain_name }} {% if item.value.get('alias') %}{{ item.value.get('alias') }}.{{ domain_name }}{% endif %};

    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    location / {
{% if item.value.get('alias') %}
        if ($host != '{{ item.key }}.{{ domain_name }}') {
            return 301 https://{{ item.key }}.{{ domain_name }}$request_uri;
        }
{% endif %}

        proxy_pass {{ 'https://' if item.value.ssl else 'http://' }}{{ item.value.host }}:{{ item.value.port }};
{% if item.value.ssl %}
        proxy_ssl_verify off;
{% endif %}
{% if lookup('file', 'files/custom_sites/{{ item.key }}.{{ domain_name }}', errors='ignore') %}
        {{ lookup('file', 'files/custom_sites/{{ item.key }}.{{ domain_name }}') }}
{% else %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }

    location @custom_502 {
        default_type text/html;
        return 502 '<html><body><h1>502 Bad Gateway</h1><p>Upstream failed: $upstream_addr</p></body></html>';
    }
}
