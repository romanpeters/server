{#
  This file is generated by Ansible. Do not edit manually.
#}
{% set raw = lookup('file', playbook_dir + '/../../services.csv') %}
{% set lines = raw.splitlines() %}
{% for line in lines[1:] %}
  {% if line.strip() %}
  {# parse CSV columns: name, public, host, port, ssl #}
  {% set cols = line.split(',') %}
  {% set name = cols[0] %}
  {% set public = cols[1] %}
  {% set host = cols[2] %}
  {% set port_raw = (cols[3] | int) %}
  {% set ssl = cols[4] %}
  {# default port if zero #}
  {% if port_raw == 0 %}
    {% if ssl == 'true' %}
      {% set port = 443 %}
    {% else %}
      {% set port = 80 %}
    {% endif %}
  {% else %}
    {% set port = port_raw %}
  {% endif %}

server {
    listen 80;
    # Serve via public domain; non-public subdomains simply won’t resolve publicly
    server_name {{ name }}.{{ domain_name }};

    # Access control: allow only local LAN ranges and Tailscale
    allow 10.10.10.0/24;
    allow 10.10.20.0/24;
    allow 10.10.11.0/24;
    allow 10.10.12.0/24;
    allow 100.64.0.0/10;
    deny all;

    location / {
        proxy_pass {{ 'https' if ssl == 'true' else 'http' }}://{{ host }}.{{ dns_domain }}:{{ port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

  {% endif %}
{% endfor %}
